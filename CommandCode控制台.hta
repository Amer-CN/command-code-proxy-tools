<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>CommandCode 代理控制台</title>
<hta:application id="ccConsole"
  applicationname="CommandCode Proxy Console"
  scroll="auto" border="thick" caption="yes" showintaskbar="yes"
  maximizebutton="yes" minimizebutton="yes"
  icon="bin\command-code-proxy.exe" />
<style>
  body { margin:0; padding:0; font-family:"Microsoft YaHei","Segoe UI",sans-serif; font-size:14px;
         background:#0f1420; color:#dde3ee; }
  .content { padding:14px 20px 18px 20px; }
  /* ---- 头部 ---- */
  .header { background:linear-gradient(135deg,#1d6df0 0%,#1446a8 100%); padding:14px 20px; }
  .header h1 { margin:0; font-size:17px; color:#fff; font-weight:bold; letter-spacing:0.5px; }
  .header .sub { margin-top:4px; font-size:12px; color:#b8d0f5; }
  .header .ver { float:right; margin-top:-30px; background:rgba(255,255,255,0.18);
                 border:1px solid rgba(255,255,255,0.35); color:#fff; font-size:11px;
                 padding:3px 10px; border-radius:12px; }
  /* ---- 状态条 ---- */
  .statusbar { background:#161d2e; border:1px solid #24304a; border-radius:8px;
               padding:12px 14px; margin:12px 0; }
  .dot { display:inline-block; width:12px; height:12px; border-radius:50%; margin-right:9px; vertical-align:middle; }
  .dot.green { background:#22c55e; box-shadow:0 0 8px #22c55e; }
  .dot.gray  { background:#64748b; }
  .dot.red   { background:#ef4444; box-shadow:0 0 8px #ef4444; }
  #statusText { font-size:14px; font-weight:bold; }
  /* ---- 分区标题 ---- */
  .sec { color:#8fa3c8; font-size:12px; margin:16px 0 8px 0; padding-left:8px;
         border-left:3px solid #1d6df0; }
  /* ---- 输入行 ---- */
  .row { margin-bottom:10px; }
  .label { display:inline-block; width:125px; color:#8fa3c8; vertical-align:middle; font-size:13px; }
  input[type=text], input[type=password] { display:inline-block; width:58%; background:#161d2e; color:#e2e8f0;
         border:1px solid #2a3a5c; border-radius:6px; padding:8px 10px; vertical-align:middle; }
  input[type=text]:focus, input[type=password]:focus { border-color:#1d6df0; }
  /* ---- 按钮 ---- */
  button { background:#24304a; color:#e2e8f0; border:1px solid #33456e; border-radius:6px;
           padding:8px 14px; cursor:pointer; }
  button:hover { background:#2e3d61; }
  button.primary { background:linear-gradient(180deg,#2c7cf5,#1d6df0); border-color:#1d6df0; font-weight:bold; }
  button.primary:hover { background:#2c7cf5; }
  button.danger { background:linear-gradient(180deg,#943030,#7c2626); border-color:#a33; }
  button.danger:hover { background:#943030; }
  .btns { margin:14px 0; }
  .btns button { margin:0 10px 8px 0; }
  /* ---- 模型 ---- */
  #modelList { padding-bottom:6px; }
  .chip { display:inline-block; background:#161d2e; border:1px solid #2a3a5c; border-radius:14px;
          padding:5px 12px; margin:3px 5px; font-size:12px; cursor:pointer; color:#a8c0e8; }
  .chip:hover { background:#24304a; border-color:#3d5a99; }
  /* ---- 日志 ---- */
  #log { background:#0a0e18; border:1px solid #1d2740; border-radius:8px; padding:10px;
         font-family:Consolas,monospace; font-size:12px; color:#7f93b8; height:100px;
         overflow-y:auto; margin-top:6px; }
  /* ---- 杀软提示横幅（首次运行） ---- */
  #avNotice { display:none; background:#2a2415; border:1px solid #8a6d1f; border-radius:8px;
              padding:10px 14px; margin-bottom:12px; font-size:12px; color:#e8c56a; line-height:1.7; }
  #avNotice button { margin-left:10px; padding:4px 12px; font-size:12px; vertical-align:middle; }
  /* ---- 底部说明 ---- */
  .tip { margin-top:12px; font-size:12px; color:#5f7298; line-height:1.8; }
</style>
</head>
<body>
<div class="header">
  <span class="ver">v1.0.8</span>
  <h1>&#9889; CommandCode 代理控制台</h1>
  <div class="sub">本地 OpenAI 兼容代理 · 普通套餐即可使用</div>
</div>
<div class="content">

  <div class="statusbar">
    <span id="dot" class="dot gray"></span>
    <span id="statusText">正在检测…</span>
  </div>

  <div id="avNotice">
    &#9888; 安全软件提示：本工具内含自解压组件与开机自启脚本，火绒 / 360 等安全软件可能误报拦截
    （无毒无害，代码完全开源）。若文件被清理，请将本工具所在文件夹加入杀软「信任区」。
    <button onclick="dismissNotice()">知道了</button>
  </div>

  <div class="sec">服务配置</div>
  <div class="row">
    <span class="label">Base URL</span>
    <input type="text" id="baseUrl" readonly value="http://127.0.0.1:55990/v1">
    <button onclick="copyText('baseUrl')">复制</button>
  </div>
  <div class="row">
    <span class="label">API Key（可选）</span>
    <input type="password" id="apiKey" placeholder="不填则使用客户端自己发送的 Key">
    <button onclick="toggleKey()">显示</button>
  </div>

  <div class="sec">操作</div>
  <div class="btns">
    <button id="toggleBtn" class="primary" onclick="toggleProxy()">&#9654; 启动代理</button>
    <button onclick="refreshNow()">&#8635; 刷新状态</button>
  </div>

  <div class="sec">可用模型 <span id="modelCount" style="color:#5f7298"></span></div>
  <div id="modelList">代理未运行时无法获取</div>

  <div class="sec">运行日志</div>
  <div id="log"></div>

  <div class="tip">
    使用步骤：<br>
    1. 点「启动代理」（或双击 启动代理.bat）→ 状态变绿即成功。<br>
    2. 在任意 Agent / 客户端里：Base URL 填 http://127.0.0.1:55990/v1 ，API Key 填 CommandCode Studio 里生成的 Key。<br>
    3. 不想每次填 Key，就在上方输入一次，点「启动代理」时会记住（保存在本目录 api-key.txt，仅本机明文）。<br>
    4. 想开机自动运行：双击 设置开机自启.bat（取消用 取消开机自启.bat）。<br>
    <br>
    关于「停止」：<br>
    · 随时可以放心关闭——不影响任何数据，只是让代理暂时停止服务；客户端会暂时连不上，重新启动即可恢复。<br>
    · 平时不用管它，一直开着就行（占用内存约 20MB）；想省资源或更新代理时再停止。<br>
    · 设置了开机自启的话，完全不用手动管，开机自动运行、随时可用。
  </div>
</div>

<script language="JScript">
var shell = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");

// 解析本文件所在目录（file:///F:/AIXM/command/xxx.hta -> F:\AIXM\command）
var loc = decodeURIComponent(String(window.location)).replace(/^file:\/\/\//, "").replace(/\//g, "\\");
var here = fso.GetParentFolderName(loc);
var exePath = here + "\\bin\\command-code-proxy.exe";
var keyFile = here + "\\api-key.txt";
var noticeFile = here + "\\notice_dismissed.flag";

var HEALTH = "http://127.0.0.1:55990/health";
var MODELS = "http://127.0.0.1:55990/v1/models";

function httpGet(url) {
  try {
    var x = new ActiveXObject("MSXML2.XMLHTTP");
    x.open("GET", url, false);
    x.send();
    return (x.status == 200) ? x.responseText : null;
  } catch (e) { return null; }
}

function isRunning() { return httpGet(HEALTH) != null; }

function log(msg) {
  var el = document.getElementById("log");
  el.innerHTML = new Date().toLocaleTimeString() + "  " + msg + "<br>" + el.innerHTML;
}

function copyText(id) {
  var v = document.getElementById(id).value;
  window.clipboardData.setData("Text", v);
  log("已复制: " + v);
}

function copyModel(name) {
  window.clipboardData.setData("Text", name);
  log("已复制模型名: " + name);
}

function toggleKey() {
  var k = document.getElementById("apiKey");
  k.type = (k.type == "password") ? "text" : "password";
}

function dismissNotice() {
  try {
    var f = fso.CreateTextFile(noticeFile, true);
    f.Close();
  } catch (e) {}
  document.getElementById("avNotice").style.display = "none";
  log("已关闭安全软件提示（下次不再显示）");
}

function refresh() {
  var running = isRunning();
  var dot = document.getElementById("dot");
  var st = document.getElementById("statusText");
  var btn = document.getElementById("toggleBtn");
  if (btn) {
    if (running) {
      btn.className = "danger";
      btn.innerHTML = "&#9632; 停止代理";
    } else {
      btn.className = "primary";
      btn.innerHTML = "&#9654; 启动代理";
    }
  }
  if (running) {
    dot.className = "dot green";
    st.innerHTML = "运行中 · http://127.0.0.1:55990 可用";
    loadModels();
  } else {
    dot.className = "dot gray";
    st.innerHTML = "未运行 · 点击「启动代理」";
    document.getElementById("modelList").innerHTML = "代理未运行时无法获取";
    document.getElementById("modelCount").innerHTML = "";
  }
}

function loadModels() {
  var txt = httpGet(MODELS);
  if (!txt) return;
  var list, i, html = "";
  try { list = eval("(" + txt + ")").data; } catch (e) { return; }
  for (i = 0; i < list.length; i++) {
    html += '<span class="chip" onclick="copyModel(\'' + list[i].id + '\')">' + list[i].id + "</span>";
  }
  document.getElementById("modelList").innerHTML = html;
  document.getElementById("modelCount").innerHTML = "（" + list.length + " 个）";
}

function startProxy() {
  if (isRunning()) { log("代理已经在运行"); refresh(); return; }
  var key = document.getElementById("apiKey").value;
  var cmd = '"' + exePath + '" -port 55990';
  if (key != "") {
    cmd += ' -api-key "' + key.replace(/"/g, '""') + '"';
    try {
      var f = fso.CreateTextFile(keyFile, true);
      f.Write(key);
      f.Close();
      log("API Key 已保存到 api-key.txt");
    } catch (e) {}
  }
  try {
    shell.Run(cmd, 0, false);  // 0 = 隐藏窗口后台运行
    log("已启动（后台运行），状态即将自动更新…");
  } catch (e) {
    log("启动失败: " + e.message);
  }
  setTimeout("refresh()", 1500);
}

function stopProxy() {
  try {
    shell.Run("taskkill /F /IM command-code-proxy.exe", 0, true);
    log("已发送停止命令");
  } catch (e) {
    log("停止失败: " + e.message);
  }
  setTimeout("refresh()", 1000);
}

function toggleProxy() {
  if (isRunning()) { stopProxy(); } else { startProxy(); }
}

(function init() {
  window.resizeTo(560, 780);  // 初始窗口大小（可拖拽调整/最大化）
  try {
    if (fso.FileExists(keyFile)) {
      var f = fso.OpenTextFile(keyFile, 1);
      document.getElementById("apiKey").value = f.ReadAll();
      f.Close();
    }
  } catch (e) {}
  try {
    if (!fso.FileExists(noticeFile)) {
      document.getElementById("avNotice").style.display = "block";
    }
  } catch (e) {}
  refresh();
  setInterval("refresh()", 3000);
})();
</script>
</body>
</html>
